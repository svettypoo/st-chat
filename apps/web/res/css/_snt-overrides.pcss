/* S&T Chat Theme Overrides — WhatsApp-inspired (Gemini design) */
/* Using flat selectors — no nesting */

/* ===== LIGHT THEME ===== */
.cpd-theme-light .mx_LeftPanel { background-color: #EDEFF1 !important; border-right: 1px solid #E0E0E0; }
.cpd-theme-light .mx_RoomView_messagePanel { background-color: #E5DDD5 !important; background-image: url("data:image/svg+xml,%3Csvg width='6' height='6' viewBox='0 0 6 6' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23000000' fill-opacity='0.03' fill-rule='evenodd'%3E%3Cpath d='M5 0h1L0 6V5zM6 5v1H5z'/%3E%3C/g%3E%3C/svg%3E"); background-repeat: repeat; }
.cpd-theme-light .mx_RoomHeader { background: #FFFFFF !important; box-shadow: 0 1px 2px rgba(0,0,0,0.08); border-bottom: none !important; }
.cpd-theme-light .mx_MessageComposer_wrapper { background-color: #EDEFF1 !important; padding: 8px 16px; box-shadow: 0 -1px 2px rgba(0,0,0,0.08); border-top: none !important; }
.cpd-theme-light .mx_BasicMessageComposer .mx_BasicMessageComposer_input { background: #FFFFFF !important; border: 1px solid #E0E0E0 !important; border-radius: 20px !important; padding: 8px 16px !important; min-height: 40px; }
.cpd-theme-light .mx_EventTile[data-self="true"] .mx_EventTile_line { background-color: rgba(217, 253, 211, 0.5); border-radius: 8px; padding: 4px 8px; margin: 2px 0; }
.cpd-theme-light .mx_EventTile:not([data-self="true"]) .mx_EventTile_line { background-color: rgba(255, 255, 255, 0.7); border-radius: 8px; padding: 4px 8px; margin: 2px 0; }

/* ===== DARK THEME ===== */
.cpd-theme-dark .mx_LeftPanel { background-color: #171F26 !important; border-right: 1px solid #333D44; }
.cpd-theme-dark .mx_RoomView_messagePanel { background-color: #0B141A !important; background-image: url("data:image/svg+xml,%3Csvg width='6' height='6' viewBox='0 0 6 6' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23FFFFFF' fill-opacity='0.03' fill-rule='evenodd'%3E%3Cpath d='M5 0h1L0 6V5zM6 5v1H5z'/%3E%3C/g%3E%3C/svg%3E"); background-repeat: repeat; }
.cpd-theme-dark .mx_RoomHeader { background: #1F2C34 !important; box-shadow: 0 1px 2px rgba(0,0,0,0.2); border-bottom: 1px solid rgba(255,255,255,0.06) !important; }
.cpd-theme-dark .mx_MessageComposer_wrapper { background-color: #1F2C34 !important; padding: 8px 16px; box-shadow: 0 -1px 2px rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.06) !important; }
.cpd-theme-dark .mx_BasicMessageComposer .mx_BasicMessageComposer_input { background: #2A3942 !important; border: 1px solid #333D44 !important; border-radius: 20px !important; padding: 8px 16px !important; min-height: 40px; }
.cpd-theme-dark .mx_EventTile[data-self="true"] .mx_EventTile_line { background-color: rgba(0, 92, 75, 0.15); border-radius: 8px; padding: 4px 8px; margin: 2px 0; }
.cpd-theme-dark .mx_EventTile:not([data-self="true"]) .mx_EventTile_line { background-color: rgba(42, 57, 66, 0.4); border-radius: 8px; padding: 4px 8px; margin: 2px 0; }

/* ===== SHARED ===== */
.mx_SupportedBrowserBanner { display: none !important; }
.mx_RoomHeader .mx_BaseAvatar { width: 40px !important; height: 40px !important; }
.mx_RoomHeader .mx_BaseAvatar img, .mx_RoomHeader .mx_BaseAvatar span { width: 40px !important; height: 40px !important; border-radius: 50% !important; }
.mx_RoomHeader_heading { font-size: 16px !important; font-weight: 600 !important; }
.mx_RoomHeader { cursor: pointer; }
