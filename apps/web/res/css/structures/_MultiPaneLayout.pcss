.mx_MultiPaneLayout {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    height: 100%;
    overflow: hidden;
}

.mx_MultiPaneLayout_grid {
    display: grid;
    flex: 1;
    min-height: 0;
    gap: 2px;
    background-color: var(--cpd-color-bg-subtle-secondary, #1a1a2e);

    &.mx_MultiPaneLayout_grid--1 {
        grid-template-columns: 1fr;
        grid-template-rows: 1fr;
    }

    &.mx_MultiPaneLayout_grid--2h {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr;
    }

    &.mx_MultiPaneLayout_grid--4 {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
    }
}

.mx_MultiPaneLayout_toolbar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 4px 8px;
    background-color: var(--cpd-color-bg-canvas-default, #15191e);
    border-top: 1px solid var(--cpd-color-border-subtle, #2d3138);
    flex-shrink: 0;
}

.mx_MultiPaneLayout_layoutBtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: none;
    color: var(--cpd-color-text-secondary, #9ba0a6);
    cursor: pointer;
    font-size: 16px;
    transition: background 0.1s ease, color 0.1s ease, border-color 0.1s ease;

    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary, rgba(255, 255, 255, 0.08));
        color: var(--cpd-color-text-primary, #e3e8f0);
    }

    &.active {
        background-color: rgba(99, 102, 241, 0.15);
        border-color: rgba(99, 102, 241, 0.5);
        color: #818cf8;
    }
}

/* PaneSlot */
.mx_PaneSlot {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--cpd-color-bg-canvas-default, #15191e);
    border: 2px solid transparent;
    border-radius: 0;
    cursor: default;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;

    &.mx_PaneSlot--active {
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.4), 0 0 12px rgba(99, 102, 241, 0.15);
        border-color: rgba(99, 102, 241, 0.4);
    }

    &.mx_PaneSlot--dragOver {
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.8), 0 0 20px rgba(99, 102, 241, 0.3);
        border-color: rgba(99, 102, 241, 0.8);
        background-color: rgba(99, 102, 241, 0.05);
    }

    &.mx_PaneSlot--empty {
        align-items: center;
        justify-content: center;
    }
}

.mx_PaneSlot_header {
    display: flex;
    align-items: center;
    padding: 4px 8px;
    background-color: var(--cpd-color-bg-subtle-primary, #1e2228);
    border-bottom: 1px solid var(--cpd-color-border-subtle, #2d3138);
    flex-shrink: 0;
    min-height: 32px;
}

.mx_PaneSlot_roomName {
    flex: 1;
    font-size: 13px;
    font-weight: 600;
    color: var(--cpd-color-text-primary, #e3e8f0);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mx_PaneSlot_closeButton {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border: none;
    border-radius: 4px;
    background: none;
    color: var(--cpd-color-text-secondary, #9ba0a6);
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    flex-shrink: 0;
    margin-left: 4px;
    padding: 0;
    transition: background 0.1s ease, color 0.1s ease;

    &:hover {
        background-color: var(--cpd-color-bg-critical-subtle, rgba(239, 68, 68, 0.15));
        color: #f87171;
    }
}

.mx_PaneSlot_content {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;

    /* Make RoomView fill the pane slot */
    .mx_RoomView {
        flex: 1;
        min-height: 0;
    }
}

.mx_PaneSlot_emptyState {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--cpd-color-text-disabled, #555b67);
    pointer-events: none;
}

.mx_PaneSlot_emptyIcon {
    font-size: 32px;
    opacity: 0.4;
}

.mx_PaneSlot_emptyText {
    font-size: 13px;
    margin: 0;
    opacity: 0.6;
}
